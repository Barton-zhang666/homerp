          "expiry": {
            "type": "string",
            "title": "Expiry"
          },
          "lot": {
            "type": "string",
            "title": "Lot"
          },
          "location": {
            "type": "string",
            "title": "Location"
          },
          "note": {
            "type": "string",
            "title": "Note"
          },
          "reverses": {
