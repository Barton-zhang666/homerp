              {
                "type": "null"
              }
            ],
            "title": "Birthday"
          },
          "contact": {
            "type": "string",
            "maxLength": 160,
            "title": "Contact",
            "default": ""
          },
          "emergency_contact": {
            "type": "string",
            "maxLength": 160,
            "title": "Emergency Contact",
            "default": ""
          },
          "backup_phone": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 64
              },
              {
                "type": "null"
              }
            ],
            "title": "Backup Phone"
          },
          "contact_email": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 254,
                "format": "email"
              },
              {
                "type": "null"
              }
            ],
            "title": "Contact Email"
          },
          "id": {
            "type": "string",
            "title": "Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "id"
        ],
        "title": "MemberView"
      },
