  "components": {
    "schemas": {
      "Action": {
        "type": "string",
        "enum": [
          "receive",
          "move",
          "lend",
          "return",
          "repair",
          "retrieve",
          "use",
          "discard",
          "count",
          "open",
          "verify_date",
          "undo"
        ],
        "title": "Action"
      },
      "Category": {
        "type": "string",
        "enum": [
          "item",
          "food",
          "medicine"
        ],
        "title": "Category"
      },
      "Credentials": {
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 254,
            "format": "email",
            "title": "Email"
          },
          "password": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "format": "password",
            "title": "Password",
            "writeOnly": true
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "title": "Credentials"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "HealthResponse"
      },
      "HoldingView": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "location": {
            "type": "string",
            "title": "Location"
          },
          "custody": {
            "type": "string",
            "title": "Custody"
          },
          "remaining": {
            "type": "string",
            "title": "Remaining"
          },
          "expiry": {
            "type": "string",
            "title": "Expiry"
          },
          "lot": {
            "type": "string",
            "title": "Lot"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "opened": {
            "type": "boolean",
            "title": "Opened"
          },
          "received_by": {
            "type": "string",
            "title": "Received By"
          }
        },
        "type": "object",
        "required": [
          "id",
          "location",
          "custody",
          "remaining",
          "expiry",
          "lot",
          "status",
          "opened",
          "received_by"
        ],
        "title": "HoldingView"
      },
      "InventoryView": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "owner_id": {
            "type": "string",
            "title": "Owner Id"
          },
          "category": {
            "$ref": "#/components/schemas/Category"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "unit": {
            "type": "string",
            "title": "Unit"
          },
          "details": {
            "$ref": "#/components/schemas/ProductDetails"
          },
          "minimum": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Minimum"
          },
          "warning_days": {
            "type": "integer",
            "title": "Warning Days"
          },
          "owned": {
            "type": "string",
            "title": "Owned"
          },
          "available": {
            "type": "string",
            "title": "Available"
          },
          "holdings": {
            "items": {
              "$ref": "#/components/schemas/HoldingView"
            },
            "type": "array",
            "title": "Holdings"
          },
          "history": {
            "items": {
              "$ref": "#/components/schemas/MovementView"
            },
            "type": "array",
            "title": "History"
          }
        },
        "type": "object",
        "required": [
          "id",
          "owner_id",
          "category",
          "name",
          "unit",
          "details",
          "minimum",
          "warning_days",
          "owned",
          "available",
          "holdings",
          "history"
        ],
        "title": "InventoryView"
      },
      "MemberView": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Name"
          },
          "relationship": {
            "type": "string",
            "maxLength": 64,
            "title": "Relationship",
            "default": ""
          },
          "birthday": {
            "anyOf": [
